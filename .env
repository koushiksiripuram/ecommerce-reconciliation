# Application
APP_NAME=E-commerce Reconciliation API
ENVIRONMENT=development
DEBUG=true

# API
API_PREFIX=/api
# JSON array format (pydantic-settings parses list values as JSON)
CORS_ORIGINS=["http://localhost:5173"]

# Database
# PostgreSQL is the only supported engine. The docker-compose stack builds its
# own DATABASE_URL for the backend container; this value is what the app and
# the CLI use when run locally against the same database.
DATABASE_URL=postgresql+psycopg2://postgres:change-me@localhost:5432/reconciliation

# Discrete PostgreSQL settings (used only when DATABASE_URL is unset)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reconciliation

