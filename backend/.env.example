# Application
APP_NAME=E-commerce Reconciliation API
ENVIRONMENT=development
DEBUG=true

# API
API_PREFIX=/api
# JSON array format (pydantic-settings parses list values as JSON)
CORS_ORIGINS=["http://localhost:5173"]

# Database
#
# Option A (recommended for hosted PostgreSQL): a single connection string.
# Most providers hand you one of these. It takes precedence over the
# POSTGRES_* variables below when set. Keep the "+psycopg2" driver suffix.
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
#
# Option B: the discrete variables below are used when DATABASE_URL is unset.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reconciliation

# Authentication / JWT
#
# JWT_SECRET_KEY must be a long, random, unique value. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder below is accepted ONLY when ENVIRONMENT is development/local/
# test; any other environment refuses to start with it.
JWT_SECRET_KEY=dev-insecure-secret-change-me-not-for-production
JWT_ALGORITHM=HS256
# Access-token lifetime in minutes.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# The access token is delivered as an HttpOnly cookie so browser JavaScript
# cannot read it.
AUTH_COOKIE_NAME=access_token
# Set to true (and serve over HTTPS) in production. Required for cross-site
# cookies together with AUTH_COOKIE_SAMESITE=none.
AUTH_COOKIE_SECURE=false
# "lax" or "strict" for same-site deployments; "none" for cross-site (needs
# AUTH_COOKIE_SECURE=true).
AUTH_COOKIE_SAMESITE=lax

# File imports
#
# Directory where uploaded source files are kept verbatim (git-ignored).
UPLOAD_STORAGE_DIR=storage/uploads
# Largest accepted upload, in bytes. Defaults to 10 MiB.
MAX_UPLOAD_SIZE_BYTES=10485760
# Rows returned by the import preview endpoint.
IMPORT_PREVIEW_ROWS=20
# Rows written per database round trip while processing an import.
IMPORT_BATCH_SIZE=500
