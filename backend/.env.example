# Application
APP_NAME=E-commerce Reconciliation API
ENVIRONMENT=development
DEBUG=true

# API
API_PREFIX=/api
# JSON array format (pydantic-settings parses list values as JSON)
CORS_ORIGINS=["http://localhost:5173"]

# Database
#
# Option A (recommended for hosted PostgreSQL): a single connection string.
# Most providers hand you one of these. It takes precedence over the
# POSTGRES_* variables below when set. Keep the "+psycopg2" driver suffix.
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
#
# Option B: the discrete variables below are used when DATABASE_URL is unset.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=reconciliation
